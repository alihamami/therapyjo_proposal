# Copy to .env for local development, or set these on the hosting platform for
# production. Never commit .env — see Production_Cutover.md for deployment notes.

# --- Supabase -------------------------------------------------------------
# Project URL and anon key. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database -------------------------------------------------------------
# Use Supabase's POOLED string (host *.pooler.supabase.com), not the direct
# one. Session pooler (port 5432) or transaction pooler (port 6543) both
# work: src/lib/prisma.ts moves the app's own pool from 5432 to 6543 by
# itself, because session mode caps the whole app at the pool size (15 on
# Nano) and fails past it with "max clients reached" (TJ-063). The Prisma
# CLI (db push, Studio, seeds) reads this variable as written, through
# prisma.config.ts, so keep 5432 here for it.
# Do not add ?pgbouncer=true: the app reaches Postgres through Prisma's pg
# driver adapter, which never names its statements.
DATABASE_URL=

# --- Auth (NextAuth v5) ---------------------------------------------------
# AUTH_SECRET: generate a fresh value per environment. Never reuse dev in prod.
AUTH_SECRET=
# AUTH_URL: must match the hostname actually being served, including scheme.
# A stale value here is the usual cause of a login that loops forever.
AUTH_URL=http://localhost:3000

# --- Google Places (reviews section) --------------------------------------
# Optional. Absent, the reviews section degrades; nothing crashes.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# --- Legacy clinic proxy ---------------------------------------------------
# Absolute origin of the legacy ASP.NET clinic system, e.g. https://www.therapyjo.com
# Unset means /clinic 404s, which is correct for preview deployments.
LEGACY_ORIGIN=

# --- Supabase (service role) -----------------------------------------------
# Required in production. Without it, patient/employee document upload and
# retrieval return 503.
SUPABASE_SERVICE_ROLE_KEY=

# --- Timezone ---------------------------------------------------------------
# Do NOT set TZ here — Vercel rejects it as a reserved variable name (it
# belongs to the underlying AWS Lambda runtime), so a project-level TZ env
# var is not an option in production. The clinic timezone (Asia/Amman) is
# instead pinned at runtime in src/instrumentation.ts, which Next calls once
# per server instance at bootstrap. See that file for the full explanation.

# --- Admin seed (prisma/seed.ts) ---------------------------------------------
# Read only by prisma/seed.ts, not by the running app. ADMIN_USERNAME and
# ADMIN_PASSWORD are required — the seed refuses to run (and never touches
# the database) if either is missing or blank, or if ADMIN_PASSWORD is the
# old "admin123" default. ADMIN_EMAIL is optional; leave it unset to leave
# the admin's email null rather than inventing an address.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
